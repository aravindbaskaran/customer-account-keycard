{
  "name": "customer-account-keycard",
  "version": "0.1.0",
  "description": "Cached Shopify customer-account sessions and test shoppers for headless tests.",
  "keywords": [
    "shopify",
    "playwright",
    "testing",
    "e2e",
    "otp",
    "customer-accounts",
    "new-customer-accounts",
    "storefront",
    "authentication",
    "storagestate",
    "testmail",
    "qa",
    "end-to-end-testing",
    "mcp"
  ],
  "author": "Aravind Baskaran",
  "license": "MIT",
  "homepage": "https://github.com/aravindbaskaran/customer-account-keycard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aravindbaskaran/customer-account-keycard.git"
  },
  "bugs": {
    "url": "https://github.com/aravindbaskaran/customer-account-keycard/issues"
  },
  "type": "module",
  "bin": {
    "keycard": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "require": "./dist/playwright/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:live": "KEYCARD_LIVE=1 vitest run test/live",
    "typecheck": "tsc --noEmit",
    "quality": "node scripts/quality-gate.mjs",
    "safety": "node scripts/repo-safety.mjs",
    "verify": "npm run safety && npm run typecheck && npm run build && npm run test:unit && npm run quality",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1",
    "@playwright/test": ">=1.40",
    "playwright": ">=1.40",
    "playwright-core": ">=1.40",
    "yaml": ">=2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.3",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
