# Copy this file to .env; never commit the copy or real values.
# Run `npx keycard init` to generate KEYCARD_KEY safely.
KEYCARD_KEY=
TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=

# Optional decision engines.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
LAYA_CACHE=

# Leave blank unless the configured development store has a password gate.
STOREFRONT_PASSWORD=
